{
  "name": "clear-debt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install": "cd frontend && yarn install && cd ../backend && pip install -r requirements.txt && cd..",
    "dev:frontend": "cd frontend && yarn dev",
    "dev:backend": "cd backend && python -X utf8 -m fastapi dev main.py",
    "dev": "concurrently --kill-others --names \"FRONTEND,BACKEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"yarn dev:frontend\" \"yarn dev:backend\"",
    "build": "cd frontend && yarn build",
    "start:frontend": "cd frontend && yarn start",
    "start": "concurrently --kill-others --names \"FRONTEND,BACKEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"yarn start:frontend\" \"yarn dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
